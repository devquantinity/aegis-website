    },
    {
      "source": "/services/infrastructure",
      "destination": "/#applications",
      "permanent": true
    },
    {
      "source": "/services/shopping-mall",
      "destination": "/#applications",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/#applications",
      "permanent": true
    },
    {
      "source": "/project/multi-wall-hollow-polycarbonate-sheet",
      "destination": "/project/polycarbonate-roofing-sheets-malaysia#hollow-polycarbonate",
      "permanent": true
    },
    {
      "source": "/project/polycarbonate-sheet",
      "destination": "/project/polycarbonate-roofing-sheets-malaysia#solid-polycarbonate",
      "permanent": true
    },
    {
      "source": "/essential_grid/aluminium-composite-panel",
      "destination": "/project/aluminium-composite-panel",
      "permanent": true
    },
    {
      "source": "/essential_grid/:path*",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/2016/10/11/the-9-advantages-of-a-polycarbonate-greenhouse-over-a-glass-one",
      "destination": "/project/polycarbonate-roofing-sheets-malaysia",
      "permanent": true
    },
    {
      "source": "/news-events/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tag/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/project",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/news-events",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/2026",
      "destination": "/api/gone"
    },
    {
      "source": "/2026/",
      "destination": "/api/gone"
    },
    {
      "source": "/2026/(.*)",
      "destination": "/api/gone"
    },
    {
      "source": "/sample-page",
      "destination": "/api/gone"
    },
    {
      "source": "/sample-page/",
      "destination": "/api/gone"
    },
    {
      "source": "/company-presentation",
      "destination": "/api/gone"
    },
    {
      "source": "/company-presentation/",
      "destination": "/api/gone"
    },
    {
      "source": "/awwards-certifications-awards",
      "destination": "/api/gone"
    },
    {
      "source": "/awwards-certifications-awards/",
      "destination": "/api/gone"
    },
    {
      "source": "/investor-relations",
      "destination": "/api/gone"
    },
    {
      "source": "/investor-relations/",
      "destination": "/api/gone"
    },
    {
      "source": "/annual-report",
      "destination": "/api/gone"
    },
    {
      "source": "/annual-report/",
      "destination": "/api/gone"
    },
    {
      "source": "/career",
      "destination": "/api/gone"
    },
    {
      "source": "/career/",
      "destination": "/api/gone"
    },
    {
      "source": "/footer",
      "destination": "/api/gone"
    },
    {
      "source": "/footer/",
      "destination": "/api/gone"
    },
    {
      "source": "/post-navigation-area",
      "destination": "/api/gone"
    },
    {
      "source": "/post-navigation-area/",
      "destination": "/api/gone"
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/api/gone"
    },
    {
      "source": "/feed",
      "destination": "/api/gone"
    },
    {
      "source": "/feed/",
      "destination": "/api/gone"
    },
    {
      "source": "/comments/feed",
      "destination": "/api/gone"
    },
    {
      "source": "/comments/feed/",
      "destination": "/api/gone"
    },
    {
      "source": "/services/feed",
      "destination": "/api/gone"
    },
    {
      "source": "/services/feed/",
      "destination": "/api/gone"
    },
    {
      "source": "/wp-content/(.*)",
      "destination": "/api/gone"
    },
    {
      "source": "/wp-includes/(.*)",
      "destination": "/api/gone"
    },
    {
      "source": "/wp-login.php",
      "destination": "/api/gone"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/catalog/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/catalog/(.*)",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/cdn.prod.website-files.com/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/d3e54v103j8qbb.cloudfront.net/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "make"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
